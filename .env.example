# ==============================================================================
# നേരംപോക്ക് (NERAMPOKKU) ENVIRONMENT CONFIGURATION
# Tagline: കളിക്കാം... സമയം പോക്കാം!
# ==============================================================================
# Copy this file to .env for local development.
# NEVER commit .env to version control!
# ==============================================================================

# --- FRONTEND CLIENT VARIABLES (Public - safe for browser) ---
# Your Supabase project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anonymous Public Key (Project Settings -> API -> anon key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# The Telegram Bot Username without @ (e.g. NeramPokkuBot)
VITE_TELEGRAM_BOT_USERNAME=NeramPokkuBot

# Production App URL on Cloudflare Pages
VITE_APP_URL=https://nerampokku.pages.dev

# --- BACKEND SECRETS (Server-Only - NEVER expose to frontend!) ---
# Supabase Service Role Key (Project Settings -> API -> service_role key)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Telegram Bot Token from @BotFather (e.g. 7123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=7123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Secret token to protect the Telegram Webhook against unauthorized requests
TELEGRAM_WEBHOOK_SECRET=your_super_secret_webhook_token_32chars

# Port for local standalone Telegram bot runner
BOT_PORT=3000
